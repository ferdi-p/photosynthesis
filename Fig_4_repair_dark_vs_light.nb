Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"for", " ", "numerical", " ", 
     RowBox[{"stability", ":", " ", 
      RowBox[{
      "a", " ", "function", " ", "that", " ", "turns", " ", "a", " ", 
       "sudden", " ", "up", " ", "down", " ", "ramp", " ", "in", " ", "a", " ",
        "continuous", " ", "function"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"with", " ", "a", " ", "small", " ", "ramp", " ", "up"}], "-", 
     RowBox[{"down", " ", "time"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"makeRampedPiecewise", "[", 
      RowBox[{"data_List", ",", "rampTime_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vals", "=", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"ends", "=", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "data", "]"}]}], ",", "segments"}], "}"}], ",", 
       RowBox[{
        RowBox[{"segments", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"v1", "=", 
                RowBox[{"vals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{"v2", "=", 
                RowBox[{"vals", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
               RowBox[{"tFlatEnd", "=", 
                RowBox[{"ends", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{"(*", 
                RowBox[{"flat", " ", "part", " ", "ends"}], "*)"}], 
               RowBox[{"tRampEnd", "=", 
                RowBox[{"ends", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
               RowBox[{"(*", 
                RowBox[{
                "ramp", " ", "finishes", " ", "at", " ", "next", " ", 
                 "segment", " ", "end"}], "*)"}], "tRampStart"}], "}"}], ",", 
             
             RowBox[{
              RowBox[{"tRampStart", "=", 
               RowBox[{"tRampEnd", "-", "rampTime"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"(*", 
                RowBox[{"flat", " ", "part"}], "*)"}], 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"v1", ",", 
                  RowBox[{"t", "<", "tRampStart"}]}], "}"}], ",", 
                RowBox[{"(*", 
                 RowBox[{"ramp", " ", "part"}], "*)"}], 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"v1", "+", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"v2", "-", "v1"}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tRampStart"}], ")"}], "/", 
                    "rampTime"}], ")"}]}]}], ",", 
                  RowBox[{"tRampStart", "<=", "t", "<", "tRampEnd"}]}], 
                 "}"}]}], "}"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"segments", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"segments", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Final", " ", "value", " ", "stays", " ", "constant", " ", "from", " ",
           "the", " ", "last", " ", "endpoint", " ", "onward"}], "*)"}], 
        RowBox[{"AppendTo", "[", 
         RowBox[{"segments", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Last", "[", "vals", "]"}], ",", 
            RowBox[{"t", ">=", 
             RowBox[{"Last", "[", "ends", "]"}]}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Piecewise", "[", "segments", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"ramp", " ", "up", " ", "down", " ", "time"}], "*)"}], "\n", 
   RowBox[{
