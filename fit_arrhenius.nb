Cell["Fit temperature deactivation", "Chapter",
 CellChangeTimes->{{3.9636827239564877`*^9, 3.963682789609782*^9}, {
  3.9681056364660187`*^9, 
  3.9681056510238028`*^9}},ExpressionUUID->"1bb1e682-2f23-49ba-9d9c-\
ad429c82913b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"from", " ", "no"}], "-", 
    RowBox[{"stress", " ", "parameters"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fit0", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Alpha]U", "\[Rule]", "6.249999999999999`*^8"}], ",", 
       RowBox[{"\[Alpha]PtotalP", "\[Rule]", "1.1607142857142856`*^9"}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"data", " ", "on", " ", "FvFm", " ", "from", " ", "Takahashi"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FvFmDarkData", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"data", "[", "\"\<FigS1\>\"", "]"}], "[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<h\>\"", "]"}], "==", "0.5"}], "&"}], "]"}], 
        "]"}], "[", 
       RowBox[{"All", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", "\"\<temp\>\"", "]"}], ",", 
           RowBox[{"#", "[", "\"\<Fv/Fm\>\"", "]"}]}], "}"}], "&"}]}], "]"}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9731048212990932`*^9, 3.973104914667498*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"0fc8410e-7573-4e57-ba83-541fe8763648"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Alpha]P", " ", "without", " ", "damage"}], ",", " ", 
    RowBox[{"at", " ", "given", " ", "temperature"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]Pxxx", "=", 
     RowBox[{"\[Alpha]PtotalP", 
      FractionBox["\[Rho]T", 
       RowBox[{"\[Rho]T", "+", 
        RowBox[{"\[Gamma]T1", "  ", 
         FractionBox[
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[Sigma]T1"}], "/", 
            RowBox[{"(", 
             RowBox[{"w", "+", "273"}], ")"}]}]], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[Sigma]T1"}], "/", 
            RowBox[{"(", 
             RowBox[{"wRef", "+", "273"}], ")"}]}]]]}], "+", 
        RowBox[{"\[Gamma]T2", "  ", 
         FractionBox[
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[Sigma]T2"}], "/", 
            RowBox[{"(", 
             RowBox[{"w", "+", "273"}], ")"}]}]], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[Sigma]T2"}], "/", 
            RowBox[{"(", 
             RowBox[{"wRef", "+", "273"}], ")"}]}]]]}]}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FvFmFunc", "=", 
     FractionBox["\[Alpha]Pxxx", 
      RowBox[{"\[Alpha]U", "+", "\[Alpha]Pxxx"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FvFmTempFit", "=", 
     RowBox[{"Quiet", "@", 
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{"FvFmDarkData", ",", " ", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FvFmFunc", "/.", "fit0"}], ",", 
          RowBox[{"\[Rho]T", "==", 
           SuperscriptBox["10", 
            RowBox[{"-", "3"}]]}], ",", 
          RowBox[{"wRef", "==", "35"}], ",", 
          RowBox[{"\[Sigma]T1", ">", "0"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"1.4", " ", 
             SuperscriptBox["10", "6"]}], ">"}], "*)"}], 
          RowBox[{"\[Sigma]T2", ">", "0"}], ",", 
          RowBox[{"\[Gamma]T1", ">", "0"}], ",", 
          RowBox[{"\[Gamma]T2", ">", "0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Sigma]T1", ",", 
            SuperscriptBox["10", "5"]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Sigma]T2", ",", 
            SuperscriptBox["10", "6"]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Rho]T", ",", 
            SuperscriptBox["10", 
             RowBox[{"-", "3"}]]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Gamma]T1", ",", 
            SuperscriptBox["10", 
             RowBox[{"-", "3"}]]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Gamma]T2", ",", 
            SuperscriptBox["10", "4"]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"wRef", ",", "35"}], "}"}]}], "}"}], ",", "w"}], "]"}]}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], 
          "<>", "\"\<export/direct-temperature-effect/two-step-arrhenius.pdf\>\
\""}], ",", "#"}], "]"}], ";", "#"}], ")"}], "&"}], "@", 
    RowBox[{"Row", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ListPlot", "[", 
         RowBox[{"FvFmDarkData", ",", "\[IndentingNewLine]", 
          RowBox[{"imageSizePadding", "[", "ImagePaddingXunits", "]"}], ",", 
          RowBox[{"PlotMarkers", "->", "plotMarkers"}], ",", 
          RowBox[{"AxesOrigin", "->", 
           RowBox[{"{", "Automatic", "}"}]}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"Dashed", ",", "colorPoints", ",", "thickness"}], "}"}], 
            "}"}]}], ",", 
          RowBox[{"Joined", "->", "False"}], ",", "style"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"FvFmTempFit", "[", "W", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"W", ",", "25", ",", "38"}], "}"}], ",", 
          RowBox[{"Evaluate", "@", "style"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"colorCurves", ",", "thickness"}], "}"}], "}"}]}]}], 
         "]"}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"None", ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"w", "/.", "units"}], ",", "None"}], "}"}]}], "}"}]}], ",", 
        RowBox[{
        "PlotLabel", 
         "->", "\"\<\!\(\*SubscriptBox[\(F\), \(V\)]\)/\!\(\*SubscriptBox[\(F\
\), \(M\)]\)\>\""}]}], "]"}], "}"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"FvFmTempFit", "[", "\"\<BestFitParameters\>\"", "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
