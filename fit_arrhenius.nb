Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]Pxxx", "=", 
   RowBox[{"\[Alpha]PtotalP", 
    FractionBox["\[Rho]T", 
     RowBox[{"\[Rho]T", "+", 
      RowBox[{"\[Gamma]T", "  ", 
       FractionBox[
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[Sigma]T"}], "/", 
          RowBox[{"(", 
           RowBox[{"w", "+", "273"}], ")"}]}]], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[Sigma]T"}], "/", 
          RowBox[{"(", 
           RowBox[{"wRef", "+", "273"}], ")"}]}]]]}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FvFmFunc", "=", 
   FractionBox["\[Alpha]Pxxx", 
    RowBox[{"\[Alpha]U", "+", "\[Alpha]Pxxx"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FvFmDarkData", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"data", "[", "\"\<FigS1\>\"", "]"}], "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<h\>\"", "]"}], "==", "0.5"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"All", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<temp\>\"", "]"}], ",", 
         RowBox[{"#", "[", "\"\<Fv/Fm\>\"", "]"}]}], "}"}], "&"}]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FvFmTempFit", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"NonlinearModelFit", "[", 
     RowBox[{"FvFmDarkData", ",", " ", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FvFmFunc", "/.", "fit0"}], ",", 
        RowBox[{"\[Rho]T", "==", 
         SuperscriptBox["10", 
          RowBox[{"-", "3"}]]}], ",", 
        RowBox[{"wRef", "==", "35"}], ",", 
        RowBox[{"(*", "1.4", "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"3", " ", 
           SuperscriptBox["10", "5"]}], ">"}], "*)"}], 
        RowBox[{"\[Sigma]T", ">", "0"}], 
        RowBox[{"(*", 
         RowBox[{"5", " ", 
          SuperscriptBox["10", "5"]}], "*)"}], ",", 
        RowBox[{"\[Gamma]T", ">", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Sigma]T", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]T", ",", ".01"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Rho]T", ",", 
          SuperscriptBox["10", 
           RowBox[{"-", "3"}]]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"wRef", ",", "35"}], "}"}]}], "}"}], ",", "w"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        "<>", "\"\<export/direct-temperature-effect/single-step-arrhenius-\
alternative.pdf\>\""}], ",", "#"}], "]"}], ";", "#"}], ")"}], "&"}], "@", 
  RowBox[{"Row", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ListPlot", "[", 
       RowBox[{"FvFmDarkData", ",", "\[IndentingNewLine]", 
        RowBox[{"imageSizePadding", "[", "ImagePaddingXunits", "]"}], ",", 
        RowBox[{"PlotMarkers", "->", "plotMarkers"}], ",", 
