        RowBox[{"Joined", "->", "False"}], ",", "style"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"FvFmTempFit", "[", "W", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"W", ",", "25", ",", "38"}], "}"}], ",", 
