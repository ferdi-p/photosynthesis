Cell[BoxData[{
 RowBox[{
  RowBox[{"FvFmMax", "=", "0.65"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit0", "=", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]U", "->", 
     RowBox[{"0.5", " ", 
      SuperscriptBox["10", "9"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"NSolve", "[", 
      RowBox[{
       RowBox[{"FvFmMax", "==", 
        FractionBox["\[Alpha]PtotalP", 
         RowBox[{"\[Alpha]U", "+", "\[Alpha]PtotalP"}]]}], "/.", "fit0"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "~", "Join", "~", "fit0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]Pxxx", "=", 
   RowBox[{"\[Alpha]PtotalP", 
    FractionBox["\[Rho]T", 
     RowBox[{"\[Rho]T", "+", 
      RowBox[{"xTref1", "  ", 
       FractionBox[
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[Sigma]T1"}], "/", 
          RowBox[{"(", 
           RowBox[{"w", "+", "273"}], ")"}]}]], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[Sigma]T1"}], "/", 
          RowBox[{"(", 
           RowBox[{"wRef", "+", "273"}], ")"}]}]]]}], "+", 
      RowBox[{"xTref2", "  ", 
       FractionBox[
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[Sigma]T2"}], "/", 
          RowBox[{"(", 
           RowBox[{"w", "+", "273"}], ")"}]}]], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[Sigma]T2"}], "/", 
          RowBox[{"(", 
           RowBox[{"wRef", "+", "273"}], ")"}]}]]]}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FvFmFunc", "=", 
    FractionBox["\[Alpha]Pxxx", 
     RowBox[{"\[Alpha]U", "+", "\[Alpha]Pxxx"}]]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"FvFmScaling", "[", "W_", "]"}], ":=", 
     RowBox[{"FvFmMax", " ", 
      RowBox[{"fT", "[", "W", "]"}]}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"FvFmDarkData", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"data", "[", "\"\<FigS1\>\"", "]"}], "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<h\>\"", "]"}], "==", "0.5"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"All", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<temp\>\"", "]"}], ",", 
         RowBox[{"#", "[", "\"\<Fv/Fm\>\"", "]"}]}], "}"}], "&"}]}], "]"}], 
    "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"data", "[", "\"\<FigS1\>\"", "]"}], "[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<h\>\"", "]"}], "==", "hour"}], "&"}], "]"}],
         "]"}], "[", 
       RowBox[{"All", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", "\"\<temp\>\"", "]"}], ",", 
           RowBox[{"#", "[", "\"\<Fv/Fm\>\"", "]"}]}], "}"}], "&"}]}], "]"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"hour", ",", 
       RowBox[{"{", "0.5", 
        RowBox[{"(*", 
         RowBox[{",", "3.5"}], "*)"}], "}"}]}], "}"}]}], "]"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FvFmTempFit", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"NonlinearModelFit", "[", 
     RowBox[{"FvFmDarkData", ",", " ", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FvFmFunc", "/.", "fit1"}], ",", 
        RowBox[{"\[Rho]T", "==", 
         SuperscriptBox["10", 
          RowBox[{"-", "3"}]]}], ",", 
        RowBox[{"wRef", "==", "35"}], ",", 
        RowBox[{"\[Sigma]T1", ">", "0"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"1.4", " ", 
           SuperscriptBox["10", "6"]}], ">"}], "*)"}], 
        RowBox[{"\[Sigma]T2", ">", "0"}], ",", 
        RowBox[{"xTref1", ">", "0"}], ",", 
        RowBox[{"xTref2", ">", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Sigma]T1", ",", 
          SuperscriptBox["10", "5"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Sigma]T2", ",", 
          SuperscriptBox["10", "6"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Rho]T", ",", 
          SuperscriptBox["10", 
           RowBox[{"-", "3"}]]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"xTref1", ",", 
          SuperscriptBox["10", 
           RowBox[{"-", "3"}]]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"xTref2", ",", 
          SuperscriptBox["10", "4"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"wRef", ",", "35"}], "}"}]}], "}"}], ",", "w"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        "<>", "\"\<export/direct-temperature-effect/two-step-arrhenius.pdf\>\"\
"}], ",", "#"}], "]"}], ";", "#"}], ")"}], "&"}], "@", 
  RowBox[{"Row", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ListPlot", "[", 
       RowBox[{"FvFmDarkData", ",", "\[IndentingNewLine]", 
        RowBox[{"imageSizePadding", "[", "ImagePaddingXunits", "]"}], ",", 
        RowBox[{"PlotMarkers", "->", "plotMarkers"}], ",", 
        RowBox[{"AxesOrigin", "->", 
