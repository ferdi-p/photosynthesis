Cell[BoxData[{
 RowBox[{
  RowBox[{"FvFmMax", "=", "0.65"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit0", "=", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]U", "->", 
     RowBox[{"0.5", " ", 
      SuperscriptBox["10", "9"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"NSolve", "[", 
      RowBox[{
       RowBox[{"FvFmMax", "==", 
        FractionBox["\[Alpha]PtotalP", 
         RowBox[{"\[Alpha]U", "+", "\[Alpha]PtotalP"}]]}], "/.", "fit0"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "~", "Join", "~", "fit0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]Pxxx", "=", 
   RowBox[{"\[Alpha]PtotalP", 
    FractionBox["\[Rho]T", 
     RowBox[{"\[Rho]T", "+", 
      RowBox[{"xTref", "  ", 
       FractionBox[
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[Sigma]T"}], "/", 
          RowBox[{"(", 
           RowBox[{"w", "+", "273"}], ")"}]}]], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[Sigma]T"}], "/", 
          RowBox[{"(", 
           RowBox[{"wRef", "+", "273"}], ")"}]}]]]}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FvFmFunc", "=", 
   FractionBox["\[Alpha]Pxxx", 
    RowBox[{"\[Alpha]U", "+", "\[Alpha]Pxxx"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FvFmDarkData", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"data", "[", "\"\<FigS1\>\"", "]"}], "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<h\>\"", "]"}], "==", "0.5"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"All", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<temp\>\"", "]"}], ",", 
         RowBox[{"#", "[", "\"\<Fv/Fm\>\"", "]"}]}], "}"}], "&"}]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FvFmTempFit", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"NonlinearModelFit", "[", 
     RowBox[{"FvFmDarkData", ",", " ", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FvFmFunc", "/.", "fit1"}], ",", 
        RowBox[{"\[Rho]T", "==", 
         SuperscriptBox["10", 
          RowBox[{"-", "3"}]]}], ",", 
        RowBox[{"wRef", "==", "35"}], ",", 
        RowBox[{"(*", "1.4", "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"3", " ", 
           SuperscriptBox["10", "5"]}], ">"}], "*)"}], 
        RowBox[{"\[Sigma]T", ">", "0"}], 
        RowBox[{"(*", 
         RowBox[{"5", " ", 
          SuperscriptBox["10", "5"]}], "*)"}], ",", 
        RowBox[{"xTref", ">", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Sigma]T", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"xTref", ",", ".01"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Rho]T", ",", 
          SuperscriptBox["10", 
           RowBox[{"-", "3"}]]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"wRef", ",", "35"}], "}"}]}], "}"}], ",", "w"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        "<>", "\"\<export/direct-temperature-effect/single-step-arrhenius-\
alternative.pdf\>\""}], ",", "#"}], "]"}], ";", "#"}], ")"}], "&"}], "@", 
  RowBox[{"Row", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ListPlot", "[", 
       RowBox[{"FvFmDarkData", ",", "\[IndentingNewLine]", 
