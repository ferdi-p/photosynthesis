Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"dataMathews", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], 
     "<>", "\"\<data/Matthews 2023 - Fig 5A-Untreated-ETRmax.csv\>\""}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9688421552746363`*^9, 3.968842193693777*^9}, {
  3.968842241256168*^9, 3.968842241851643*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"a7d1084f-a406-45d8-804a-2678924a9758"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gauss", "=", 
   RowBox[{"a", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"x", "-", "b"}], "c"], ")"}], "2"]}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.968842403889679*^9, 3.9688424059931583`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"a5ac48bc-1e48-4c16-b609-ac003f9ca593"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fitMatthews", "=", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"ToExpression", "@", 
     RowBox[{"dataMathews", "[", 
      RowBox[{"[", 
       RowBox[{"3", ";;", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"gauss", ",", 
      RowBox[{"a", ">", "200"}], ",", 
      RowBox[{"c", ">", "0"}], ",", 
      RowBox[{"b", ">", "20"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "x"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9688423369458227`*^9, 3.968842458125512*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"6624e3d0-a5e8-4e66-8848-ef1976d5d872"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"a", "\[Rule]", "226.68248901829884`"}], ",", 
   RowBox[{"b", "\[Rule]", "28.14195234231181`"}], ",", 
   RowBox[{"c", "\[Rule]", "14.08642109321281`"}]}], "}"}]], "Output",
